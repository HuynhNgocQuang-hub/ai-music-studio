# ===========================================
# AI Music Studio - Environment Configuration
# ===========================================

# Dual LLM Cloud API Keys (at least one optional; Mock provider runs if both are empty)
GEMINI_API_KEY=
OPENAI_API_KEY=
DEFAULT_LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini

# Redis State & Cache (Docker Compose uses redis://redis:6379/0)
REDIS_URL=redis://redis:6379/0
PROJECT_TTL_SECONDS=86400
AUDIO_TTL_SECONDS=43200

# Audio Processing & Rendering
SOUNDFONT_PATH=/usr/share/sounds/sf2/FluidR3_GM.sf2
TEMP_STORAGE_DIR=/tmp/ai_music_studio
MAX_UPLOAD_MB=50
MASTER_LIMITER_CEILING_DB=-1.0
TARGET_LUFS=-14.0

# API & CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
