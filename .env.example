# ===========================================
# AI Music Studio - Environment Configuration
# ===========================================

# Spring Boot Profile (local | docker)
SPRING_PROFILES_ACTIVE=local

# Dual LLM Cloud API Keys (optional; deterministic Mock provider runs if both are empty)
GEMINI_API_KEY=
OPENAI_API_KEY=
DEFAULT_LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash
OPENAI_MODEL=gpt-4o-mini

# Redis State & Cache (Docker Compose uses redis://redis:6379/0; host default 16379 avoids conflicts)
REDIS_HOST_PORT=16379
REDIS_URL=redis://127.0.0.1:16379/0
PROJECT_TTL_SECONDS=86400
AUDIO_TTL_SECONDS=43200

# Slim Python Audio DSP Worker (Docker Compose uses http://audio-worker:8001)
AUDIO_WORKER_URL=http://localhost:8001

# Audio Processing & Rendering
SAMPLE_RATE=44100
SOUNDFONT_PATH=/usr/share/sounds/sf2/FluidR3_GM.sf2
MAX_UPLOAD_MB=50
MASTER_LIMITER_CEILING_DB=-1.0
TARGET_LUFS=-14.0

# API & CORS (React + Vite dev server + optional local Caddy HTTPS proxy)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,https://localhost:8443

# Phase 8: Multi-User Cloud Workspace, PostgreSQL, MinIO S3, JWT & Quota
POSTGRES_HOST_PORT=15432
POSTGRES_DB=aimusic
DATABASE_URL=
DATABASE_USER=aimusic
DATABASE_PASS=aimusic_dev_pass

MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
S3_ENDPOINT=
S3_BUCKET=aimusic-cloud
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

JWT_SECRET=
JWT_EXPIRATION_SECONDS=604800
QUOTA_DAILY_GENERATE=30
QUOTA_DAILY_EXPORT=50
HTTP_PROXY_PORT=8080
HTTPS_PORT=8443
